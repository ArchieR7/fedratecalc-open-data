{
  "metadata": {
    "name": "State minimum wage rates 2026-2027",
    "description": "The general statewide hourly minimum wage in the 50 states and the District of Columbia: the rate on January 1, 2026, the rate at the end of 2026 and its effective date, and the 2027 rate and effective date. A state whose 2027 rate has not been set in law or announced is marked \"not announced\" and has no 2027 rate. City and county minimums, tipped, youth, training and industry-specific wages follow different rules and are not in this file.",
    "url": "https://fedratecalc.com/data/state-minimum-wage-2026-2027/",
    "license": "https://creativecommons.org/licenses/by/4.0/",
    "licenseName": "CC BY 4.0",
    "attribution": "FedRateCalc",
    "attributionText": "FedRateCalc (https://fedratecalc.com/data/state-minimum-wage-2026-2027/), CC BY 4.0",
    "licenseNote": "The rates come from state agencies and the U.S. Department of Labor; reuse terms of a state agency's own pages are set by that state.",
    "sources": [
      {
        "label": "U.S. Department of Labor: State Minimum Wage Laws",
        "href": "https://www.dol.gov/agencies/whd/minimum-wage/state"
      }
    ],
    "generated": "2026-11-05",
    "dataAsOf": "2026-10-16",
    "temporalCoverage": "2026-01-01/2027-12-31",
    "columns": [
      {
        "name": "state",
        "type": "string",
        "meaning": "State name (the District of Columbia is included)."
      },
      {
        "name": "state_abbr",
        "type": "string",
        "meaning": "Two-letter postal abbreviation."
      },
      {
        "name": "rate_2026_start",
        "type": "number",
        "meaning": "General hourly minimum in effect on January 1, 2026, in U.S. dollars."
      },
      {
        "name": "rate_2026_end",
        "type": "number",
        "meaning": "General hourly minimum in effect on December 31, 2026, in U.S. dollars."
      },
      {
        "name": "rate_2026_end_effective",
        "type": "date",
        "meaning": "Date the rate in rate_2026_end took effect (YYYY-MM-DD)."
      },
      {
        "name": "rate_2027",
        "type": "number",
        "meaning": "General hourly minimum for 2027 in U.S. dollars; empty when no 2027 rate is set or announced."
      },
      {
        "name": "rate_2027_effective",
        "type": "date",
        "meaning": "Date the 2027 rate takes effect (YYYY-MM-DD); empty when there is none."
      },
      {
        "name": "status_2027",
        "type": "enum",
        "meaning": "scheduled (set in law or announced), no change scheduled, or not announced."
      },
      {
        "name": "federal_minimum_applies",
        "type": "boolean",
        "meaning": "true when the federal $7.25 is the effective floor for covered employers in the state."
      },
      {
        "name": "source_url",
        "type": "string",
        "meaning": "The state agency or official page the rate was read from (the first source on the state's FedRateCalc page)."
      },
      {
        "name": "page_url",
        "type": "string",
        "meaning": "The state's FedRateCalc minimum wage page."
      }
    ]
  },
