    "columns": [
      {
        "name": "state",
        "type": "string",
        "meaning": "State name (the District of Columbia is included)."
      },
      {
        "name": "state_abbr",
        "type": "string",
        "meaning": "Two-letter postal abbreviation."
      },
      {
        "name": "status",
        "type": "enum",
        "meaning": "verified when the rate was read in an official source and saved, pending when it has not been read yet."
      },
      {
        "name": "tax_kind",
        "type": "enum",
        "meaning": "sales (a state sales tax), none (the source says no general sales tax), get (Hawaii general excise tax) or tpt (Arizona transaction privilege tax); empty for a pending state."
      },
      {
        "name": "statewide_rate_pct",
        "type": "number",
        "meaning": "Statewide rate in percent; 0 where there is no general sales tax; empty for a pending state, which has no rate in this file."
      },
      {
        "name": "rate_effective_date",
        "type": "date",
        "meaning": "Date the source says the rate took effect (YYYY-MM-DD); empty when the source does not say."
      },
      {
        "name": "effective_note",
        "type": "string",
        "meaning": "The source document's own date (for example an agency publication's effective date), which is not the date the rate took effect; empty when there is none."
      },
      {
        "name": "local_taxes",
        "type": "enum",
        "meaning": "yes or no when the source says local sales taxes apply or do not, unstated when it says nothing; empty for a pending state."
      },
      {
        "name": "caveat",
        "type": "string",
        "meaning": "A limit on how far the statewide rate reaches, taken from the source (for example a separate rate that applies to part of the state); empty when there is none."
      },
      {
        "name": "source_type",
        "type": "enum",
        "meaning": "agency page (the state tax agency web page), statute (the state code as the state publishes it) or agency PDF (an agency publication or rate chart)."
      },
      {
        "name": "citation",
        "type": "string",
        "meaning": "Statute citation or publication name for a statute or PDF source; empty for an agency page."
      },
      {
        "name": "source_url",
        "type": "string",
        "meaning": "The official page the rate was read from; for a pending state, the official page still to be read."
      },
      {
        "name": "checked",
        "type": "date",
        "meaning": "The date the verified state's source was checked (YYYY-MM-DD); empty for a pending state."
      },
      {
        "name": "page_url",
        "type": "string",
        "meaning": "The state's FedRateCalc sales tax calculator page; empty for a pending state, whose page shows no rate."
      }
    ]
  },
